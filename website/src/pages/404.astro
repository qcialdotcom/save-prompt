---
// src/pages/404.astro
import NotFoundImage from "@/assets/404.png";
import { DOWNLOAD_ROUTE, HOME_ROUTE } from "@/configs/routes";
import { SITE_INFO } from "@/configs/site";
import Main from "@/layouts/main.astro";
import { ArrowRight, Compass } from "@lucide/astro";
import { Image } from "astro:assets";
---

<Main>
  <Fragment slot="content">
    <section
      aria-labelledby="not-found-title"
      class="relative flex items-center overflow-hidden py-12 sm:py-20 lg:min-h-[calc(100dvh-4rem)]"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 top-0 z-0 h-128 bg-linear-to-b from-primary-fixed/60 to-transparent dark:from-primary-container/20"
      >
      </div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -left-24 top-1/2 z-0 size-96 rounded-full bg-secondary/10 blur-3xl"
      >
      </div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -right-24 -top-24 z-0 size-96 rounded-full bg-primary/10 blur-3xl"
      >
      </div>

      <div
        class="relative z-10 mx-auto grid w-full max-w-300 items-center gap-10 px-4 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16"
      >
        <div class="text-center lg:text-left">
          <p
            class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary"
          >
            <Compass class="size-3.5" />
            Error 404
          </p>

          <p
            aria-hidden="true"
            class="mt-6 select-none bg-linear-to-b from-primary to-secondary bg-clip-text text-8xl font-extrabold leading-none tracking-tighter text-transparent xxs:text-9xl sm:text-[10rem] lg:text-[11rem]"
          >
            404
          </p>

          <h1
            id="not-found-title"
            class="mx-auto mt-4 max-w-2xl text-balance text-3xl font-extrabold tracking-tight text-on-surface sm:text-4xl lg:mx-0"
          >
            This page <span class="text-primary">wandered off</span>
          </h1>
          <p class="mx-auto mt-4 max-w-xl text-pretty text-base leading-7 text-on-surface-variant sm:text-lg lg:mx-0">
            The page you're looking for doesn't exist or may have been moved. Let's get you back to something useful.
          </p>

          <div class="mt-8 flex flex-col items-stretch justify-center gap-3 xs:flex-row lg:justify-start">
            <a
              href={HOME_ROUTE.path}
              class="group/cta inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 rounded-full bg-primary px-6 font-semibold text-on-primary no-underline shadow-[0_8px_24px_var(--color-shadow-primary)] transition-all duration-200 hover:opacity-90 hover:shadow-[0_12px_32px_var(--color-shadow-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary active:scale-[0.98] motion-reduce:transition-none motion-reduce:active:scale-100"
            >
              Back to home
              <ArrowRight
                class="size-4 transition-transform duration-200 group-hover/cta:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover/cta:translate-x-0"
              />
            </a>
            <a
              href={DOWNLOAD_ROUTE.path}
              class="inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 rounded-full border border-outline px-6 font-semibold text-on-surface no-underline transition-all duration-200 hover:border-primary/40 hover:bg-surface-container focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary active:scale-[0.98] motion-reduce:transition-none motion-reduce:active:scale-100"
            >
              Get {SITE_INFO.name}
            </a>
          </div>
        </div>

        <div
          class="relative isolate overflow-hidden rounded-3xl border border-primary/15 bg-surface-container-low p-3 shadow-[0_24px_64px_var(--color-shadow-soft)] sm:p-6"
        >
          <div aria-hidden="true" class="absolute -right-20 -top-20 -z-10 size-64 rounded-full bg-secondary/10 blur-3xl"></div>
          <Image
            src={NotFoundImage}
            alt="A group of colorful characters searching for a missing page"
            class="h-auto w-full object-contain"
          />
        </div>
      </div>
    </section>
  </Fragment>
</Main>
