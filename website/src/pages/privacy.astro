---
// src/pages/privacy.astro
import { Check, LockKeyhole, ShieldCheck } from "@lucide/astro";
import Main from "@/layouts/main.astro";
import { PRIVACY_PAGE_CONTENT } from "@/configs/content";
import { SITE_INFO } from "@/configs/site";
---

<Main
  title={`Privacy policy | ${SITE_INFO.name}`}
  description={`How ${SITE_INFO.name} handles your data and protects your prompt library.`}
  url="/privacy"
>
  <Fragment slot="content">
    <section class="bg-surface-container-low py-16 sm:py-24">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <div class="text-center">
          <span class="inline-flex size-14 items-center justify-center rounded-2xl bg-primary text-on-primary"
            ><ShieldCheck class="size-7" /></span
          ><p class="mt-6 text-sm font-semibold uppercase tracking-wider text-primary">Privacy, plainly stated</p><h1
            class="mt-3 text-4xl font-extrabold tracking-tight text-on-surface sm:text-5xl"
          >
            Your prompts are yours
          </h1><p class="mt-5 text-lg leading-relaxed text-on-surface-variant">{PRIVACY_PAGE_CONTENT.intro}</p>
        </div>
        <div class="mt-12 space-y-5">
          {
            PRIVACY_PAGE_CONTENT.sections.map((section) => (
              <article class="rounded-2xl border border-outline-variant bg-surface-container-lowest p-6 shadow-[0_2px_8px_var(--color-shadow-soft)] sm:p-8">
                <div class="flex gap-4">
                  <>
                    <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary-fixed text-on-primary-fixed">
                      <Check class="size-5" />
                    </span>
                    <div>
                      <>
                        <h2 class="text-xl font-bold text-on-surface">{section.title}</h2>
                        <p class="mt-2 leading-relaxed text-on-surface-variant">{section.text}</p>
                      </>
                    </div>
                  </>
                </div>
              </article>
            ))
          }
          <div class="rounded-2xl border border-primary/20 bg-primary/10 p-6 sm:p-8">
            <h2 class="text-xl font-bold text-on-surface">Privacy checklist</h2><ul class="mt-4 grid gap-3 sm:grid-cols-2">
              {
                PRIVACY_PAGE_CONTENT.checklist.map((item) => (
                  <li class="flex gap-2 text-sm leading-relaxed text-on-surface-variant">
                    <Check class="size-4 shrink-0 text-tertiary" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="rounded-2xl border border-outline-variant bg-surface-container-lowest p-6 sm:p-8">
            <p class="text-sm font-semibold uppercase tracking-wider text-primary">A practical privacy model</p><h2
              class="mt-3 text-2xl font-bold text-on-surface"
            >
              Good defaults, clear choices
            </h2><div class="mt-6 space-y-6">
              {
                PRIVACY_PAGE_CONTENT.principles.map((principle) => (
                  <article>
                    <>
                      <h3 class="text-lg font-semibold text-on-surface">{principle.title}</h3>
                      <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">{principle.text}</p>
                    </>
                  </article>
                ))
              }
            </div>
          </div>
          <div class="rounded-2xl border border-outline-variant bg-surface p-6 sm:p-8">
            <div class="flex gap-4">
              <LockKeyhole class="mt-1 size-5 shrink-0 text-primary" /><p class="text-sm leading-relaxed text-on-surface-variant">
                {PRIVACY_PAGE_CONTENT.note} Contact <a
                  class="font-semibold text-primary underline"
                  href={`mailto:${SITE_INFO.email}`}>{SITE_INFO.email}</a
                >.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </Fragment>
</Main>
