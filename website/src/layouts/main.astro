---
// src/layouts/main.astro

import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar.astro";
import { FAVICONS, createOpenGraphConfig, createSeoExtendConfig, createTwitterCardConfig } from "@/configs/seo";
import { SITE_INFO } from "@/configs/site";
import "@/styles/global.css";
import { SEO } from "astro-seo";
import { Schema } from "astro-seo-schema";

interface Props {
  title?: string;
  description?: string;
  url?: string;
  image?: string;
  imageAlt?: string;
  keywords?: string[];
  noindex?: boolean;
  nofollow?: boolean;
}

const {
  title = SITE_INFO.title,
  description = SITE_INFO.description,
  url = SITE_INFO.url,
  image = SITE_INFO.ogImage.src,
  imageAlt = SITE_INFO.ogImage.alt,
  keywords = SITE_INFO.keywords,
  noindex = false,
  nofollow = false,
} = Astro.props;

const canonical = new URL(url, SITE_INFO.url).toString();
const absoluteImage = new URL(image, SITE_INFO.url).toString();
const openGraph = createOpenGraphConfig({ title, description, url: canonical, image: absoluteImage, imageAlt });
const twitter = createTwitterCardConfig({ title, description, url: canonical, image: absoluteImage, imageAlt });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      nofollow={nofollow}
      openGraph={openGraph}
      twitter={twitter}
      extend={createSeoExtendConfig(keywords)}
    />
    {
      FAVICONS.map((icon) => (
        <link rel={icon.rel} href={icon.href} type={icon.type} {...(icon.sizes ? { sizes: icon.sizes } : {})} />
      ))
    }
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "Organization",
        name: SITE_INFO.name,
        url: SITE_INFO.url,
        logo: new URL(SITE_INFO.logo.src, SITE_INFO.url).toString(),
        description: SITE_INFO.description,
        parentOrganization: { "@type": "Organization", name: SITE_INFO.parent.name, url: SITE_INFO.parent.url },
        sameAs: Object.values(SITE_INFO.socials),
      }}
    />
    <slot name="head" />
  </head>
  <body class="min-h-dvh flex flex-col bg-surface text-on-surface">
    <Navbar />
    <main class="flex-1 mt-16">
      <slot name="content" />
    </main>
    <Footer />
  </body>
</html>
