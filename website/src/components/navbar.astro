---
// src/components/navbar.astro
import logo from "@/assets/logo.png";
import {
  DOWNLOAD_ROUTE,
  FAQ_ROUTE,
  FEATURES_ROUTE,
  HOME_ROUTE,
  HOW_IT_WORKS_ROUTE,
  COMPARE_ROUTE,
  GUIDE_ROUTE,
  PRIVACY_ROUTE,
  ROADMAP_ROUTE,
} from "@/configs/routes";
import { SITE_INFO } from "@/configs/site";
import { Download, Menu, Moon, Sun, X } from "@lucide/astro";
import { Image } from "astro:assets";

const LINKS = [FEATURES_ROUTE, HOW_IT_WORKS_ROUTE, COMPARE_ROUTE, GUIDE_ROUTE, PRIVACY_ROUTE, ROADMAP_ROUTE, FAQ_ROUTE];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-outline-variant/20 bg-surface/85 backdrop-blur-md transition-shadow duration-300"
>
  <nav aria-label="Main" class="mx-auto flex h-16 max-w-300 items-center justify-between px-4 sm:px-6">
    <a
      href={HOME_ROUTE.path}
      class="flex items-center gap-2 text-lg font-bold tracking-tight text-on-surface no-underline sm:text-xl"
    >
      <Image
        src={logo}
        alt={SITE_INFO.logo.alt}
        width={32}
        height={32}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
        class="h-8 w-8 rounded-lg"
      />
      <span>{SITE_INFO.name}</span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        LINKS.map((route) => (
          <li>
            <a
              href={route.path}
              class="rounded-lg px-3 py-2 text-sm font-medium text-on-surface-variant no-underline transition-colors hover:bg-surface-container hover:text-on-surface"
            >
              {route.name}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <button
        type="button"
        aria-label="Toggle dark mode"
        class="theme-toggle relative inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-on-surface-variant transition-colors hover:bg-surface-container hover:text-primary"
      >
        <Moon class="theme-icon-moon h-5 w-5" />
        <Sun class="theme-icon-sun h-5 w-5" />
      </button>

      <a
        href={DOWNLOAD_ROUTE.path}
        class="hidden items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-on-primary no-underline transition-opacity hover:opacity-90 xs:inline-flex"
      >
        <Download class="h-4 w-4" />
        {DOWNLOAD_ROUTE.name}
      </a>

      <button
        id="menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-on-surface transition-colors hover:bg-surface-container lg:hidden"
      >
        <Menu class="h-5 w-5" />
      </button>
    </div>
  </nav>
</header>

<div
  id="menu-overlay"
  class="pointer-events-none fixed inset-0 z-40 h-dvh bg-black/40 opacity-0 transition-opacity duration-300 lg:hidden"
>
</div>

<aside
  id="mobile-menu"
  aria-label="Mobile menu"
  class="invisible fixed right-0 top-0 z-50 flex h-dvh w-72 max-w-[85%] translate-x-full flex-col bg-surface-container-lowest text-on-surface shadow-xl transition-transform duration-300 ease-in-out lg:hidden"
>
  <div class="flex h-16 shrink-0 items-center justify-between border-b border-outline-variant/30 px-5">
    <span class="flex items-center gap-2 text-base font-bold">
      <Image src={logo} alt="" width={28} height={28} densities={[1, 2]} loading="lazy" class="h-7 w-7 rounded-lg" />
      {SITE_INFO.name}
    </span>
    <button
      id="menu-close"
      type="button"
      aria-label="Close menu"
      class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full transition-colors hover:bg-surface-container"
    >
      <X class="h-5 w-5" />
    </button>
  </div>

  <ul class="flex flex-1 flex-col gap-1 overflow-y-auto p-4">
    {
      LINKS.map((route) => (
        <li>
          <a
            href={route.path}
            class="mobile-link block rounded-lg px-3 py-3 text-base font-medium text-on-surface-variant no-underline transition-colors hover:bg-surface-container hover:text-on-surface"
          >
            {route.name}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="flex shrink-0 flex-col gap-2 border-t border-outline-variant/30 p-4">
    <button
      type="button"
      aria-label="Toggle dark mode"
      class="theme-toggle relative inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-lg bg-surface-container px-4 py-2.5 text-sm font-semibold text-on-surface transition-colors hover:bg-surface-container-high"
    >
      <span class="relative inline-flex h-5 w-5 items-center justify-center">
        <Moon class="theme-icon-moon h-5 w-5" />
        <Sun class="theme-icon-sun h-5 w-5" />
      </span>
      Toggle theme
    </button>
    <a
      href={DOWNLOAD_ROUTE.path}
      class="mobile-link inline-flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-on-primary no-underline transition-opacity hover:opacity-90"
    >
      <Download class="h-4 w-4" />
      {DOWNLOAD_ROUTE.name}
    </a>
  </div>
</aside>

<style>
  .theme-icon-sun {
    display: none;
  }
  :global(.dark) .theme-icon-moon {
    display: none;
  }
  :global(.dark) .theme-icon-sun {
    display: block;
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const root = document.documentElement;

  const updateHeader = () => {
    const scrolled = window.scrollY > 8;
    header?.classList.toggle("shadow-sm", scrolled);
    header?.classList.toggle("shadow-on-surface/10", scrolled);
  };
  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });

  const applyTheme = (isDark: boolean) => {
    root.classList.toggle("dark", isDark);
    try {
      localStorage.setItem("theme", isDark ? "dark" : "light");
    } catch {}
  };
  let stored: string | null = null;
  try {
    stored = localStorage.getItem("theme");
  } catch {}
  applyTheme(stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches);

  document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((btn) => {
    btn.addEventListener("click", () => applyTheme(!root.classList.contains("dark")));
  });

  const menuToggle = document.getElementById("menu-toggle");
  const menuClose = document.getElementById("menu-close");
  const mobileMenu = document.getElementById("mobile-menu");
  const overlay = document.getElementById("menu-overlay");

  const openMenu = () => {
    mobileMenu?.classList.remove("translate-x-full", "invisible");
    overlay?.classList.remove("opacity-0", "pointer-events-none");
    menuToggle?.setAttribute("aria-expanded", "true");
    document.body.classList.add("overflow-hidden");
  };

  const closeMenu = () => {
    mobileMenu?.classList.add("translate-x-full");
    overlay?.classList.add("opacity-0", "pointer-events-none");
    menuToggle?.setAttribute("aria-expanded", "false");
    document.body.classList.remove("overflow-hidden");
    setTimeout(() => {
      if (mobileMenu?.classList.contains("translate-x-full")) mobileMenu.classList.add("invisible");
    }, 300);
  };

  menuToggle?.addEventListener("click", openMenu);
  menuClose?.addEventListener("click", closeMenu);
  overlay?.addEventListener("click", closeMenu);
  document.querySelectorAll(".mobile-link").forEach((a) => a.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (e) => e.key === "Escape" && closeMenu());
  window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => e.matches && closeMenu());
</script>
