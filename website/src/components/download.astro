---
// src/components/download.astro
import { DESKTOP_DOWNLOADS, EXTENSION_DOWNLOADS } from "@/configs/downloads";
import { SITE_INFO } from "@/configs/site";
import DownloadCard from "./download-card.astro";
---

<section
  id="download"
  aria-labelledby="download-title"
  class="relative scroll-mt-16 overflow-hidden border-t border-outline-variant/30 bg-surface py-16 sm:py-24"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 z-0 h-96 bg-linear-to-b from-primary-fixed/50 to-transparent dark:from-primary-container/20"
  >
  </div>

  <div class="relative mx-auto w-full max-w-300 px-4 sm:px-6">
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary">Download</p>
      <h2 id="download-title" class="mt-2 text-balance text-3xl font-extrabold tracking-tight text-on-surface sm:text-4xl">
        Get {SITE_INFO.name} on your devices
      </h2>
      <p class="mt-4 text-pretty text-base text-on-surface-variant sm:text-lg">
        Free to use, no account needed. Pick your browser or desktop platform below.
      </p>
    </div>

    <div class="flex flex-col gap-12">
      <div>
        <h3 class="mb-4 text-center text-xl font-bold text-on-surface">Browser extension</h3>
        <ul class="mx-auto grid max-w-3xl gap-4 md:grid-cols-2">
          {EXTENSION_DOWNLOADS.map((target) => <DownloadCard target={target} />)}
        </ul>
      </div>

      <div>
        <h3 class="mb-4 text-center text-xl font-bold text-on-surface">Desktop app</h3>
        <ul class="grid gap-4 md:grid-cols-3">
          {DESKTOP_DOWNLOADS.map((target) => <DownloadCard target={target} />)}
        </ul>
      </div>
    </div>
  </div>
</section>
