---
// src/components/faq.astro
import { FAQ } from "@/configs/content";
import { ChevronDown } from "@lucide/astro";
---

<section
  id="faq"
  aria-labelledby="faq-title"
  class="relative scroll-mt-16 overflow-hidden border-t border-outline-variant/30 bg-surface py-16 sm:py-24"
>
  <div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-24 z-0 size-96 rounded-full bg-primary/10 blur-3xl">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-300 px-4 sm:px-6">
    <div class="mx-auto mb-12 max-w-2xl text-center sm:mb-14">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary"
      >
        <span aria-hidden="true" class="size-1.5 rounded-full bg-primary"></span>
        FAQ
      </p>
      <h2 id="faq-title" class="mt-4 text-balance text-3xl font-extrabold tracking-tight text-on-surface sm:text-4xl">
        Frequently asked <span class="text-primary">questions</span>
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-pretty text-base text-on-surface-variant sm:text-lg">
        Quick answers to the things people ask the most.
      </p>
    </div>

    <div class="mx-auto flex max-w-3xl flex-col gap-3">
      {
        FAQ.map((item, i) => (
          <details
            open={i === 0}
            class="group rounded-2xl border border-outline-variant bg-surface-container-lowest shadow-[0_2px_8px_var(--color-shadow-soft)] transition-all duration-200 hover:border-primary/40 open:border-primary/40 open:bg-surface-container-low open:shadow-[0_12px_28px_var(--color-shadow-primary)] motion-reduce:transition-none"
          >
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 rounded-2xl px-5 py-4 text-left font-semibold text-on-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:px-6 [&::-webkit-details-marker]:hidden">
              <span class="min-w-0 text-base sm:text-lg">{item.q}</span>
              <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-primary-fixed text-on-primary-fixed transition-all duration-200 group-open:rotate-180 group-open:bg-primary group-open:text-on-primary motion-reduce:transition-none">
                <ChevronDown class="size-4" />
              </span>
            </summary>
            <p class="px-5 pb-5 text-sm leading-relaxed text-on-surface-variant sm:px-6 sm:pb-6 sm:text-base">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
