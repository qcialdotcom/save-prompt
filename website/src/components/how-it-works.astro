---
// src/components/how-it-works.astro
import { DOWNLOAD_ROUTE } from "@/configs/routes";
import { STEPS } from "@/configs/content";
import { ArrowRight, Copy, Pencil, Search } from "@lucide/astro";

const ICONS = { pencil: Pencil, search: Search, copy: Copy } as const;
---

<section
  id="how-it-works"
  aria-labelledby="how-title"
  class="relative scroll-mt-16 overflow-hidden border-t border-outline-variant/30 bg-surface py-16 sm:py-24"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-24 top-1/3 z-0 size-96 rounded-full bg-secondary/10 blur-3xl"
  >
  </div>

  <div class="relative z-10 mx-auto w-full max-w-300 px-4 sm:px-6">
    <div class="mx-auto mb-12 max-w-2xl text-center sm:mb-14">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary"
      >
        <span aria-hidden="true" class="size-1.5 rounded-full bg-primary"></span>
        How it works
      </p>
      <h2 id="how-title" class="mt-4 text-balance text-3xl font-extrabold tracking-tight text-on-surface sm:text-4xl">
        From idea to reusable prompt <span class="text-primary">in seconds</span>
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-pretty text-base text-on-surface-variant sm:text-lg">
        Three simple steps. No account, no setup, no friction.
      </p>
    </div>

    <ol class="mx-auto flex max-w-2xl flex-col">
      {
        STEPS.map((step, i) => {
          const Icon = ICONS[step.icon as keyof typeof ICONS];
          const isLast = i === STEPS.length - 1;
          return (
            <li class="group relative flex gap-4 pb-8 last:pb-0 sm:gap-6">
              {!isLast && (
                <span
                  aria-hidden="true"
                  class="absolute bottom-0 left-5 top-10 w-0.5 -translate-x-1/2 rounded-full bg-linear-to-b from-primary/60 to-outline-variant/40"
                />
              )}

              <span
                aria-hidden="true"
                class="relative z-10 inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-primary text-base font-bold text-on-primary shadow-[0_8px_24px_var(--color-shadow-primary)] ring-4 ring-surface transition-transform duration-200 group-hover:scale-110 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
              >
                {i + 1}
              </span>

              <div class="min-w-0 flex-1 cursor-default rounded-2xl border border-outline-variant bg-surface-container-lowest p-5 shadow-[0_2px_8px_var(--color-shadow-soft)] transition-all duration-200 group-hover:-translate-y-1 group-hover:border-primary/40 group-hover:shadow-[0_12px_28px_var(--color-shadow-primary)] motion-reduce:transition-none motion-reduce:group-hover:translate-y-0 sm:p-6">
                <div class="flex items-start gap-4">
                  <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-primary-fixed text-on-primary-fixed transition-colors duration-200 group-hover:bg-primary group-hover:text-on-primary motion-reduce:transition-none">
                    {Icon && <Icon class="size-5" />}
                  </span>
                  <div class="min-w-0">
                    <h3 class="text-lg font-semibold text-on-surface sm:text-xl">
                      <span class="sr-only">Step {i + 1}: </span>
                      {step.title}
                    </h3>
                    <p class="mt-1 text-sm leading-relaxed text-on-surface-variant sm:text-base">{step.text}</p>
                  </div>
                </div>
              </div>
            </li>
          );
        })
      }
    </ol>

    <div class="mt-12 flex flex-col items-center gap-3">
      <a
        href={DOWNLOAD_ROUTE.path}
        class="group/cta inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 rounded-full bg-primary px-6 font-semibold text-on-primary no-underline shadow-[0_8px_24px_var(--color-shadow-primary)] transition-all duration-200 hover:opacity-90 hover:shadow-[0_12px_32px_var(--color-shadow-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary active:scale-[0.98] motion-reduce:transition-none motion-reduce:active:scale-100"
      >
        Get started free
        <ArrowRight
          class="size-4 transition-transform duration-200 group-hover/cta:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover/cta:translate-x-0"
        />
      </a>
      <p class="text-sm text-on-surface-variant">Free · Local-first · No login</p>
    </div>
  </div>
</section>
